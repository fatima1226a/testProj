# Адрес Django API. По умолчанию '/api' на том же адресе: в dev Vite проксирует его на
# http://localhost:8000 (см. vite.config.ts, VITE_PROXY_TARGET меняет цель прокси).
# Абсолютный адрес нужен только если API на другом домене: тогда на сервере включите
# CORS с credentials и CSRF_TRUSTED_ORIGINS для адреса фронта.
# VITE_API_URL=/api
