{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAST LIGHT sites v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "datasetId", "window", "sites"],
  "properties": {
    "version": {"enum": [1, 2]},
    "datasetId": {"type": "string", "minLength": 1},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "count"],
      "oneOf": [{"required": ["stepH"]}, {"required": ["stepMinutes"]}],
      "properties": {
        "start": {"$ref": "#/$defs/utc"},
        "stepH": {"const": 1},
        "stepMinutes": {"enum": [10, 60]},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "sites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/site"}}
  },
  "$defs": {
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "azimuth": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
    "elevation": {"type": "number", "minimum": -90, "maximum": 90},
    "horizon": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/elevation"}},
    "hour": {
      "type": "object", "additionalProperties": false,
      "required": ["t", "sunAz", "sunEl", "earthAz", "earthEl"],
      "properties": {
        "t": {"$ref": "#/$defs/utc"},
        "sunAz": {"$ref": "#/$defs/azimuth"},
        "sunEl": {"$ref": "#/$defs/elevation"},
        "earthAz": {"$ref": "#/$defs/azimuth"},
        "earthEl": {"$ref": "#/$defs/elevation"}
      }
    },
    "site": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "lat", "lon", "horizon", "hours"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "stepMinutes": {"enum": [10, 60]},
        "horizon": {"$ref": "#/$defs/horizon"},
        "horizonByMast": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {"5": {"$ref": "#/$defs/horizon"}, "10": {"$ref": "#/$defs/horizon"}}
        },
        "horizonClones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/horizon"}},
        "hours": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hour"}}
      }
    }
  }
}
