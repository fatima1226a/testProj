{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAST LIGHT validation v1",
  "type": "object", "additionalProperties": false,
  "required": ["datasetId", "checks"],
  "properties": {
    "datasetId": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "level", "status", "ranAt", "measurement", "tolerance", "report"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "level": {"enum": [null, 1, 2, 3, 4]},
          "status": {"enum": ["pending", "passed", "failed"]},
          "ranAt": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"},
          "measurement": {"type": ["object", "null"]},
          "tolerance": {"type": ["object", "null"]},
          "report": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
               "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
            ]
          }
        }
      }
    }
  }
}
