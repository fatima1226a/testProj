{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAST LIGHT provenance v1",
  "type": "object", "additionalProperties": false,
  "required": ["datasetId", "mode", "generator", "seed", "coordinateConventions", "sources", "capabilities", "sitesSha256", "notes"],
  "properties": {
    "datasetId": {"type": "string", "minLength": 1},
    "mode": {"enum": ["demo", "final"]},
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "seed": {"type": ["integer", "null"]},
    "coordinateConventions": {
      "type": "object", "additionalProperties": false,
      "required": ["angles", "heights", "time", "azimuth", "longitude", "horizonMastM"],
      "properties": {
        "angles": {"const": "degrees"}, "heights": {"const": "meters"},
        "time": {"const": "UTC"}, "azimuth": {"const": "north-clockwise"},
        "longitude": {"const": "east-positive [-180,180]"},
        "horizonMastM": {"const": 2}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "synthetic", "url", "query", "version", "accessedAt", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "synthetic": {"type": "boolean"},
          "url": {"type": ["string", "null"], "format": "uri"},
          "query": {"type": ["string", "null"], "minLength": 1},
          "version": {"type": ["string", "null"], "minLength": 1},
          "accessedAt": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["minCapacity", "heater", "uncertainty"],
      "properties": {"minCapacity": {"type": "boolean"}, "heater": {"type": "boolean"}, "uncertainty": {"type": "boolean"}}
    },
    "sitesSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "secondSignature": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "signedBy", "signedAt", "sitesSha256", "scope", "comment"],
      "properties": {
        "status": {"enum": ["pending", "signed"]},
        "signedBy": {"type": ["string", "null"], "minLength": 1},
        "signedAt": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"},
        "sitesSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope": {"const": "fixture-expectations"},
        "comment": {"type": "string"}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
